{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "AWS_ENDPOINT_URL",
    "AWS_REGION",
    "BUILDER_CALLBACK_TOKEN",
    "DATABASE_URL",
    "ECS_CLUSTER",
    "ECS_CONTAINER_NAME",
    "ECS_LAUNCH_TYPE",
    "ECS_SECURITY_GROUPS",
    "ECS_TASK_DEFINITION",
    "ECS_VPC_SUBNETS",
    "PREVIEW_DOMAIN",
    "REDIS_URL",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
