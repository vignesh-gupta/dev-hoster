# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# --- Mock backend (TODO-remove-last) ---
# JSON "database" directory; defaults to <repo>/temp.
# MOCK_DB_DIR=
# Multiplier for the simulated build speed (2 = twice as fast).
# MOCK_BUILD_SPEED=1
# Host used to build each project's public URL (<slug>.<PREVIEW_DOMAIN>).
# PREVIEW_DOMAIN=localhost:8000
