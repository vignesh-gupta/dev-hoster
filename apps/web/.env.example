# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Redis (build logs: the builder publishes, the web app subscribes)
REDIS_URL="redis://localhost:6379"

# Shared secret the builder container sends when reporting build status
BUILDER_CALLBACK_TOKEN="change-me"

# Host the preview proxy serves projects from (<slug>.<PREVIEW_DOMAIN>)
PREVIEW_DOMAIN="localhost:8000"

# ECS (defaults target floci at http://localhost:4566)
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_REGION=us-east-1
# ECS_CLUSTER=default
# ECS_TASK_DEFINITION=builder-server-task
# ECS_CONTAINER_NAME=builder-server
# ECS_LAUNCH_TYPE=FARGATE
# ECS_VPC_SUBNETS=
# ECS_SECURITY_GROUPS=
